# ModelRadar local development environment.
# Do NOT put real secrets in this file. Generate your own .env with:
#   Windows:  powershell -ExecutionPolicy Bypass -File scripts/init-env.ps1
#   macOS/Linux:  sh scripts/init-env.sh
# Values equal to CHANGE_ME are replaced with random credentials.

COMPOSE_PROJECT_NAME=modelradar

POSTGRES_DB=modelradar
# Database owner: used only by the database container itself (and later, migrations).
POSTGRES_OWNER_USER=modelradar_owner
POSTGRES_OWNER_PASSWORD=CHANGE_ME
# Worker role: read/write. API role: read-only.
WORKER_DB_PASSWORD=CHANGE_ME
API_DB_PASSWORD=CHANGE_ME

# Host ports (all bound to 127.0.0.1 only).
DB_HOST_PORT=5432
API_HOST_PORT=8000
WEB_HOST_PORT=3000
